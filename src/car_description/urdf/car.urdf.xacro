
bot xmlns:xacro="http://www.ros.org/wiki/xacro" name="car">

  <!-- Base -->
  <link name="base_link"/>

  <!-- LiDAR -->
  <link name="laser"/>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="-0.5 0.0 0.25" rpy="0 0 0"/>
  </joint>

</robot>
