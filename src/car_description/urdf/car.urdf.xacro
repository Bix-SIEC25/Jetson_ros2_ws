<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="car">

  <!-- Base -->
  <link name="base_link"/>

  <!-- LiDAR -->
  <link name="scan"/>

  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="scan"/>
    <origin xyz="-0.5 0.0 0.25" rpy="0 0 0"/>
  </joint>

</robot>
